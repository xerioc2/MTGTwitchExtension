GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Prefer the local bridge so detection regions merge into the current GameState.
BRIDGE_URL=http://localhost:8080

# Only required when BRIDGE_URL is not used.
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key_here

# Dedicated dev channel only; must not be xerioc2.
RELAY_CHANNEL_ID=your-dev-channel
