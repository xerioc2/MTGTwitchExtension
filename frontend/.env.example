VITE_TWITCH_CLIENT_ID=your_twitch_client_id_here
VITE_BACKEND_WS_URL=ws://your_backend_url/ws/game-state
VITE_BACKEND_API_URL=http://your_backend_url
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
VITE_SUPABASE_CHANNEL_ID=xerioc2

# Optional V2 screen hover detection plumbing. Leave false for Twitch review builds.
VITE_ENABLE_SCREEN_DETECTIONS=false

# Backend-only. Never expose a real service role key in frontend builds.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_CHANNEL_ID=xerioc2
SUPABASE_RELAY_FUNCTION_URL=https://your-project.supabase.co/functions/v1/publish-game-state
BRIDGE_PUBLISH_TOKEN=generate_a_long_random_bridge_publish_token
ENABLE_SCREEN_DETECTIONS=false
ENABLE_SCREEN_DETECTIONS_MOCK=false
SCREEN_DETECTIONS_TTL=PT2S
ENABLE_SCREEN_DETECTOR=false
SCREEN_DETECTOR_MODE=none
SCREEN_DETECTOR_MIN_INTERVAL=PT1S
